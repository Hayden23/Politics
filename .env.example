# ── Required ──
DATABASE_URL=postgresql://civic:civic@localhost:5432/civic_dev
# Random 32+ byte secret; used for OAuth state signing and analytics pseudonyms.
AUTH_SECRET=change-me
# Public origin, used for OAuth redirects and CSRF origin checks.
APP_URL=http://localhost:3000

# ── Roles ──
# Accounts that sign up with these emails become admins. Promote others with `npm run set-role`.
ADMIN_EMAILS=
# Require a second editor to approve a story (recommended once you have 2+ editors).
EDITORIAL_TWO_PERSON_RULE=false

# ── Google sign-in (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI drafting (optional; without it editors write drafts by hand) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_REQUEST_LIMIT=200
# anthropic | mock (tests only; refused in production)
# AI_PROVIDER=

# ── Ingestion (optional) ── comma-separated "Name|https://feed.url"
INGEST_FEEDS=

# ── Results ──
SMALL_SAMPLE_THRESHOLD=30
STATE_RESULTS_THRESHOLD=100

# ── Ops ──
ANALYTICS_RETENTION_DAYS=180
# Optional webhook (Slack-compatible JSON {text}) for server errors.
ERROR_WEBHOOK_URL=
DATABASE_SSL=
# NEXT_PUBLIC_APP_NAME=Civic Lens

# ── v2: breakdown thresholds (minimum valid responses before a group is shown) ──
IDEOLOGY_RESULTS_THRESHOLD=100
DEMOGRAPHIC_RESULTS_THRESHOLD=100

# ── v2: email digests ── resend | (unset = log only)
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="Civic Lens <no-reply@example.com>"
DIGEST_HOUR_UTC=13
